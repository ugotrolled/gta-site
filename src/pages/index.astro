---
import '../styles/global.css';
import cheats from '../cheats.json';
---

<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>GTA 6 — Читы, трейнеры, коды и моды для одиночной игры</title>
    <meta name="description" content="Скачать бесплатные легальные читы, конфиги и моды для GTA 6. Проверенные файлы без вирусов.">
</head>
<body class="bg-[#0d0e12] text-gray-100 min-h-screen flex flex-col font-sans">

    <!-- Навбар в стиле игрового портала -->
    <header class="bg-[#14161d] border-b border-white/10 sticky top-0 z-50">
        <div class="max-w-6xl mx-auto px-4 h-16 flex items-center justify-between">
            <div class="flex items-center gap-6">
                <a href="/" class="flex items-center gap-2">
                    <span class="bg-gradient-to-r from-pink-500 to-orange-500 text-white font-black px-2.5 py-1 rounded text-sm tracking-wider">GTA VI</span>
                    <span class="font-extrabold text-lg tracking-tight text-white">MODS & CHEATS</span>
                </a>
                <nav class="hidden md:flex gap-5 text-sm font-medium text-gray-400">
                    <a href="/" class="text-white">Все файлы</a>
                    <a href="/" class="hover:text-pink-400 transition">Трейнеры</a>
                    <a href="/" class="hover:text-pink-400 transition">Чит-коды</a>
                    <a href="/" class="hover:text-pink-400 transition">Сохранения</a>
                </nav>
            </div>
            <span class="text-xs bg-emerald-500/15 text-emerald-400 border border-emerald-500/30 px-3 py-1 rounded-full font-semibold">
                ✓ Проверено антивирусом
            </span>
        </div>
    </header>

    <!-- Шапка игры (Hero-блок как на VGTimes) -->
    <div class="relative bg-[#14161d] border-b border-white/10 overflow-hidden">
        <div class="absolute inset-0 bg-[url('https://images.unsplash.com/photo-1514565131-fce0801e5785?auto=format&fit=crop&w=1600&q=80')] bg-cover bg-center opacity-20"></div>
        <div class="absolute inset-0 bg-gradient-to-t from-[#0d0e12] via-[#0d0e12]/70 to-transparent"></div>
        
        <div class="relative max-w-6xl mx-auto px-4 py-12 flex flex-col md:flex-row items-start md:items-end gap-6">
            <img src="https://images.unsplash.com/photo-1605810230434-7631ac76ec81?auto=format&fit=crop&w=400&q=80" alt="GTA 6 Cover" class="w-28 h-36 object-cover rounded-xl border-2 border-pink-500/50 shadow-2xl shadow-pink-500/20" />
            <div>
                <div class="flex flex-wrap gap-2 mb-3">
                    <span class="text-xs font-bold uppercase tracking-wider bg-pink-600 text-white px-2.5 py-0.5 rounded">Grand Theft Auto VI</span>
                    <span class="text-xs font-medium bg-white/10 text-gray-300 px-2.5 py-0.5 rounded">PC / PS5 / Xbox Series</span>
                </div>
                <h1 class="text-3xl md:text-4xl font-black text-white tracking-tight mb-2">
                    Читы и файлы для GTA 6
                </h1>
                <p class="text-gray-300 text-sm md:text-base max-w-2xl">
                    Каталог бесплатных конфигураций, трейнеров и внутриигровых комбинаций для одиночного прохождения. Все файлы проверены и не влияют на сетевой режим.
                </p>
            </div>
        </div>
    </div>

    <!-- Каталог файлов (Карточки в стиле VGTimes) -->
    <main class="max-w-6xl mx-auto px-4 py-10 flex-grow w-full">
        <div class="flex items-center justify-between mb-6">
            <h2 class="text-xl font-bold text-white">Популярные файлы ({cheats.length})</h2>
            <span class="text-xs text-gray-400">Обновлено: Ноябрь 2026</span>
        </div>

        <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
            {cheats.map((item) => (
                <article class="bg-[#161821] border border-white/10 hover:border-pink-500/50 rounded-2xl overflow-hidden flex flex-col transition-all duration-200 hover:-translate-y-1 shadow-xl">
                    <a href={`/${item.slug}`} class="relative block h-48 overflow-hidden group">
                        <img src={item.image} alt={item.title} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300" />
                        <span class="absolute top-3 left-3 bg-black/75 backdrop-blur-md text-pink-400 text-xs font-bold px-2.5 py-1 rounded-md border border-white/10">
                            {item.category}
                        </span>
                        <span class="absolute bottom-3 right-3 bg-emerald-500 text-black text-xs font-black px-2 py-0.5 rounded">
                            ★ {item.rating}
                        </span>
                    </a>
                    
                    <div class="p-5 flex flex-col flex-grow justify-between">
                        <div>
                            <a href={`/${item.slug}`}>
                                <h3 class="text-lg font-bold text-white hover:text-pink-400 transition-colors mb-2 leading-snug">
                                    {item.title}
                                </h3>
                            </a>
                            <p class="text-gray-400 text-sm line-clamp-2 mb-4">
                                {item.text}
                            </p>
                        </div>

                        <div class="pt-4 border-t border-white/10 flex items-center justify-between text-xs text-gray-400">
                            <div class="flex items-center gap-3">
                                <span>📦 {item.size}</span>
                                <span>⬇️ {item.downloads}</span>
                            </div>
                            <a href={`/${item.slug}`} class="text-pink-400 hover:text-pink-300 font-bold">
                                Скачать →
                            </a>
                        </div>
                    </div>
                </article>
            ))}
        </div>
    </main>

    <footer class="bg-[#14161d] border-t border-white/10 py-8 text-center text-xs text-gray-500">
        <p>© 2026 GTA 6 Mods & Cheats Portal. Все файлы предназначены исключительно для одиночной игры.</p>
    </footer>

</body>
</html>
